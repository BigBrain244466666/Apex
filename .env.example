# ---- Supabase ----
# Create a free project at https://supabase.com
# Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# ---- Server ----
PORT=3000

# ---- Huawei Health Kit ----
# Leave HUAWEI_DEMO_MODE=true to use realistic sample sleep data.
# Set to false + fill in the rest once you have a Huawei developer account.
HUAWEI_DEMO_MODE=true
HUAWEI_CLIENT_ID=
HUAWEI_CLIENT_SECRET=
HUAWEI_REDIRECT_URI=http://localhost:3000/api/huawei/callback

# ---- Nutrition APIs ----
# USDA FoodData Central: get a free key at https://fdc.nal.usda.gov/api-key-signup.html
# STRONGLY recommended — best results for generic foods like eggs and cheese.
USDA_API_KEY=
